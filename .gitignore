# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Android TWA (android-twa/) — build output and signing secrets. The
# upload keystore itself is generated outside the repo entirely; these
# patterns are defense-in-depth in case anything ends up inside the
# project directory by mistake. Never committed, never deployed to
# Infomaniak (only dist/ is, via the FTP workflow).
android-twa/*.keystore
android-twa/*.jks
android-twa/key.properties
android-twa/local.properties
android-twa/.gradle/
android-twa/build/
android-twa/app/build/
android-twa/*.apk
android-twa/*.aab

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
